<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Tringle_calcolator</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Назва exe (TriangleCalculator.exe) і опис у Диспетчері задач — незалежно від назви проєкту -->
    <AssemblyName>TriangleCalculator</AssemblyName>
    <AssemblyTitle>Triangle Calculator</AssemblyTitle>
    <!-- Іконка exe; вікно без власного Icon бере її ж -->
    <ApplicationIcon>TriangleCalculator.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="1.png" />
    <None Remove="2.png" />
    <None Remove="priamyi.png" />
    <None Remove="fonts\*.ttf" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="1.png" />
    <Resource Include="2.png" />
    <Resource Include="priamyi.png" />
    <!-- Шрифт вбудований у exe: на ПК без встановленого Montserrat вигляд не зміниться -->
    <Resource Include="fonts\*.ttf" />
  </ItemGroup>

</Project>
