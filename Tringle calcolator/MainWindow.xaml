<Window x:Class="Tringle_calcolator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Tringle_calcolator"
        mc:Ignorable="d"
        Title="MainWindow" Height="600" Width="1000">
    <Window.Resources>

        <!-- Стиль 1: форма клавіші Enter -->
        <Style x:Key="EnterKeyButton" TargetType="Button">
            <Setter Property="Width" Value="128"/>
            <Setter Property="Height" Value="88"/>
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Foreground" Value="#C0C0C0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="GlowBorder"
                                CornerRadius="14"
                                Background="Transparent"
                                BorderBrush="White"
                                BorderThickness="2.5"
                                Opacity="0"
                                RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform x:Name="GlowScale" ScaleX="1" ScaleY="1"/>
                                    </Border.RenderTransform>
                                    <Border.Effect>
                                        <BlurEffect Radius="20"/>
                                    </Border.Effect>
                            </Border>
                            <Border x:Name="KeyBody"
                             Background="#1E1E1E"
                             CornerRadius="10"
                             BorderBrush="#484848"
                             BorderThickness="1,1,1,4">
                                <Grid>
                                    <StackPanel HorizontalAlignment="Right"
                                                VerticalAlignment="Bottom"
                                                Margin="0,0,12,10">   

                                        <TextBlock x:Name="EnterArrow"
                                            Text="↵"
                                            FontSize="20"
                                            Foreground="#d0d0d0"
                                            HorizontalAlignment="Right"/>

                                        <!-- дві копії тексту в одній комірці Grid -->
                                        <Grid HorizontalAlignment="Right">

                                            <!-- шар 1: ореол -->
                                            <TextBlock x:Name="EnterGlow"
                                                Text="{TemplateBinding Content}"
                                                FontSize="{TemplateBinding FontSize}"
                                                FontWeight="{TemplateBinding FontWeight}"
                                                Foreground="#39FF88"
                                                Opacity="0"
                                                IsHitTestVisible="False">
                                                <TextBlock.Effect>
                                                    <BlurEffect Radius="14"/>
                                                </TextBlock.Effect>
                                            </TextBlock>

                                            <!-- шар 2: чіткий текст -->
                                            <TextBlock x:Name="EnterText"
                                                Text="{TemplateBinding Content}"
                                                FontSize="{TemplateBinding FontSize}"
                                                FontWeight="{TemplateBinding FontWeight}"
                                                Foreground="#5A5A5A"/>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="True">
                                <Setter TargetName="EnterText" Property="Foreground" Value="#C8FFDC"/>
                                <Setter TargetName="EnterArrow" Property="Foreground" Value="#8CFFB8"/>
                                <Setter TargetName="EnterText" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#00FF7F"
                                                          BlurRadius="22"
                                                          ShadowDepth="0"
                                                          Opacity="0.95"/>
                                    </Setter.Value>
                                </Setter>

                                <Trigger.EnterActions>
                                    <BeginStoryboard x:Name="GlowPulse">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="EnterGlow"
                                                             Storyboard.TargetProperty="Opacity"
                                                             From="0.25" To="1"
                                                             Duration="0:0:1.1"
                                                             AutoReverse="True"
                                                             RepeatBehavior="Forever"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>

                                <Trigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="GlowPulse"/>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="1.10" Duration="0:0:0.18"/>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" To="1.10" Duration="0:0:0.18"/>
                                            <DoubleAnimation Storyboard.TargetName="GlowBorder" Storyboard.TargetProperty="Opacity" To="0.88" Duration="0:0:0.18"/>
                                            <DoubleAnimation Storyboard.TargetName="GlowScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.18"/>
                                            <DoubleAnimation Storyboard.TargetName="GlowScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.18"/>
                                            <ColorAnimation Storyboard.TargetName="KeyBody" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#2c2c2c" Duration="0:0:0.3"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="1.0" Duration="0:0:0.18"/>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" To="1.0" Duration="0:0:0.18"/>
                                            <DoubleAnimation Storyboard.TargetName="GlowBorder" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"/>
                                            <DoubleAnimation Storyboard.TargetName="GlowScale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.18"/>
                                            <DoubleAnimation Storyboard.TargetName="GlowScale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.18"/>
                                            <ColorAnimation Storyboard.TargetName="KeyBody" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#1E1E1E" Duration="0:0:0.3"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="1.04" Duration="0:0:0.07"/>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" To="1.04" Duration="0:0:0.07"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль 2: ASSYOUASKED — додає фіолетовий Tag-бейдж -->
        <Style x:Key="ASSYOUASKED" TargetType="Button" BasedOn="{StaticResource EnterKeyButton}">
            <Setter Property="Tag" Value="ASSYOUASKED"/>
            <Setter Property="ToolTip" Value="Style: ASSYOUASKED"/>
        </Style>

    </Window.Resources>


    <Grid>
        <Grid.Background>
            <RadialGradientBrush>
                <GradientStop Color="#0a0a0a" Offset="0"/>
                <GradientStop Color="#030303" Offset="0.8"/>
                
            </RadialGradientBrush>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition  Width="20*"/>
            <ColumnDefinition  Width="60*"/>
            <ColumnDefinition  Width="25*"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Row="0" Grid.ColumnSpan="3" Opacity="0.15">
            <Grid.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="Black" Offset="1"/>
                  <!-- <GradientStop Color="#FF8A73BF" Offset="0"/> -->
                </LinearGradientBrush>
            </Grid.Background>
        </Grid>
        <Grid Grid.Row="0" Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="TriangleDovilnyi" Grid.Column="0" Background="Transparent" BorderThickness="0">
                <Image Source="/1.png" Stretch="None" Cursor="Hand" >
                    <Image.Style>
                        <Style TargetType="Image">
                            <Setter Property="Opacity" Value="0.8"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Opacity" Value="1"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Image.Style>
                </Image>
            </Button>
            <Button x:Name="TrianglePriamokutnyi" Grid.Column="1" Background="Transparent" BorderThickness="0">
                <Image Source="/priamyi.png" Cursor="Hand" Stretch="None">
                    <Image.Style>
                        <Style TargetType="Image">
                            <Setter Property="Opacity" Value="0.8"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Opacity" Value="1"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Image.Style>
                </Image>
            </Button>
        </Grid>
        <Grid Grid.Column="1" Grid.Row="1">
            <Border Background="#333333" Opacity="0.2"/>
            <Canvas x:Name="CANVAS">
                <!-- Підписи вершин -->
                <TextBlock x:Name="LabelA" Text="A" Foreground="White" FontFamily="Montserrat" FontSize="24" FontWeight="Bold"/>
                <TextBlock x:Name="LabelB" Text="B" Foreground="White" FontFamily="Montserrat" FontSize="24" FontWeight="Bold"/>
                <TextBlock x:Name="LabelC" Text="C" Foreground="White" FontFamily="Montserrat" FontSize="24" FontWeight="Bold"/>

                <!-- Поля вводу на сторонах -->
                <Border x:Name="CanvasABBorder" CornerRadius="6" BorderBrush="#555" BorderThickness="1" Background="#1A1A1A">
                    <TextBox x:Name="CanvasABBox" Width="60" Background="Transparent"
                 BorderThickness="0" Foreground="White" CaretBrush="White"
                 TextAlignment="Center" Padding="4,2"/>
                </Border>
                <Border x:Name="CanvasBCBorder" CornerRadius="6" BorderBrush="#555" BorderThickness="1" Background="#1A1A1A">
                    <TextBox x:Name="CanvasBCBox" Width="60" Background="Transparent"
                 BorderThickness="0" Foreground="White" CaretBrush="White"
                 TextAlignment="Center" Padding="4,2"/>
                </Border>
                <Border x:Name="CanvasCАBorder" CornerRadius="6" BorderBrush="#555" BorderThickness="1" Background="#1A1A1A">
                    <TextBox x:Name="CanvasCABox" Width="60" Background="Transparent"
                 BorderThickness="0" Foreground="White" CaretBrush="White"
                 TextAlignment="Center" Padding="4,2"/>
                </Border>
            </Canvas>
        </Grid>
        <Grid Grid.Column="0" Grid.Row="1" Margin="15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <!-- AB -->
            <TextBlock Text="AB:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Foreground="white" HorizontalAlignment="Center" FontSize="20" FontFamily="Montserrat"/>
            <Border Grid.Row="0" Grid.Column="1" Margin="6 10" CornerRadius="10" BorderBrush="#555" BorderThickness="1" Background="#1A1A1A">
                <TextBox x:Name="ABTextBox" Grid.Row="0" Grid.Column="1"  Background="Transparent" BorderThickness ="0" TextAlignment="Center" FontSize="16" Foreground="White"/>
            </Border>
            <!-- BC -->
            <TextBlock Text="BC:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Foreground="white" HorizontalAlignment="Center" FontSize="20" FontFamily="Montserrat"/>
            <Border Grid.Row="1" Grid.Column="1" Margin="6 10" CornerRadius="10" BorderBrush="#555" BorderThickness="1" Background="#1A1A1A">
                <TextBox x:Name="BCTextBox" Grid.Row="1" Grid.Column="1" Background="Transparent" BorderThickness ="0" TextAlignment="Center" FontSize="16" Foreground="White"/>
            </Border>
            <!-- CA -->
            <TextBlock Text="CA:" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Foreground="white" HorizontalAlignment="Center" FontSize="20" FontFamily="Montserrat"/>
            <Border Grid.Row="2" Grid.Column="1" Margin="6 10" CornerRadius="10" BorderBrush="#555" BorderThickness="1" Background="#1A1A1A">
                <TextBox x:Name="CATextBox" Grid.Row="2" Grid.Column="1" Background="Transparent" BorderThickness ="0" TextAlignment="Center" FontSize="16" Foreground="White"/>
            </Border>
            <!-- ∠A -->
            <TextBlock Text="∠A:" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Foreground="white" HorizontalAlignment="Center" FontSize="20" FontFamily="Montserrat"/>
            <Border Grid.Row="3" Grid.Column="1" Margin="6 10" CornerRadius="10" BorderBrush="#555" BorderThickness="1" Background="#1A1A1A">
                <TextBox x:Name="ATextBox" Grid.Row="3" Grid.Column="1" Background="Transparent" BorderThickness ="0" TextAlignment="Center" FontSize="16" Foreground="White"/>
            </Border>
            <!-- ∠B -->
            <TextBlock Text="∠B:" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Foreground="white" HorizontalAlignment="Center" FontSize="20" FontFamily="Montserrat"/>
            <Border Grid.Row="4" Grid.Column="1" Margin="6 10" CornerRadius="10" BorderBrush="#555" BorderThickness="1" Background="#1A1A1A">
                <TextBox x:Name="BTextBox" Grid.Row="4" Grid.Column="1" Background="Transparent" BorderThickness ="0" TextAlignment="Center" FontSize="16" Foreground="White"/>
            </Border>
            <!-- ∠C -->
            <TextBlock Text="∠C:" Grid.Row="5" Grid.Column="0" VerticalAlignment="Center" Foreground="white" HorizontalAlignment="Center" FontSize="20" FontFamily="Montserrat"/>
            <Border Grid.Row="5" Grid.Column="1" Margin="6 10" CornerRadius="10" BorderBrush="#555" BorderThickness="1" Background="#1A1A1A">
                <TextBox x:Name="CTextBox" Grid.Row="5" Grid.Column="1" Background="Transparent" BorderThickness ="0" TextAlignment="Center" FontSize="16" Foreground="White"/>
            </Border>
        </Grid>
        <Grid Grid.Column="2" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Button x:Name="EnterButton" Style="{StaticResource EnterKeyButton}" Content="ENTER" Click="OnEnterClick" VerticalAlignment="Center" HorizontalAlignment="Center" />
        </Grid>


    </Grid>
</Window>
