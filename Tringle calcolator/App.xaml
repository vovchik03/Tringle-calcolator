<Application x:Class="Tringle_calcolator.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Tringle_calcolator"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Montserrat з папки fonts, вбудований у збірку. "#Montserrat" — назва сімейства всередині .ttf -->
        <FontFamily x:Key="MontserratFont">pack://application:,,,/fonts/#Montserrat</FontFamily>
    </Application.Resources>
</Application>
